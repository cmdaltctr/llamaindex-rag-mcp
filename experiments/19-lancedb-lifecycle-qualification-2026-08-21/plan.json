{
  "experiment_id": "19-lancedb-lifecycle-qualification",
  "protocol_version": "1.0",
  "experimental_unit": "lancedb-lifecycle-gate",
  "primary_metric": "gates_passed",
  "manipulated_factors": [
    {
      "name": "gate",
      "levels": [
        "G1_real_write", "G2_restart_reopen", "G3_dense_retrieval",
        "G4_bm25_hybrid", "G5_metadata_filters", "G6_unchanged_reingest",
        "G7_replacement", "G8_document_deletion", "G9_collection_deletion",
        "G10_identity_stamping", "G11_generation_invalidation",
        "G12_interrupted_write_recovery", "G13_narrowed_lock_concurrent_read",
        "G14_manifest_plan_agreement"
      ]
    }
  ],
  "controlled_variables": {
    "vector_store": "lancedb",
    "collection": "qual_documents",
    "embed_provider": "local",
    "embed_backend": "ollama",
    "embed_model": "nomic-embed-text",
    "sparse_backend": "bm25",
    "metadata_extraction_mode": "disabled",
    "pdf_reader": "pypdf"
  },
  "cells": [
    { "id": "G1_real_write", "factors": { "gate": "G1_real_write" } },
    { "id": "G2_restart_reopen", "factors": { "gate": "G2_restart_reopen" } },
    { "id": "G3_dense_retrieval", "factors": { "gate": "G3_dense_retrieval" } },
    { "id": "G4_bm25_hybrid", "factors": { "gate": "G4_bm25_hybrid" } },
    { "id": "G5_metadata_filters", "factors": { "gate": "G5_metadata_filters" } },
    { "id": "G6_unchanged_reingest", "factors": { "gate": "G6_unchanged_reingest" } },
    { "id": "G7_replacement", "factors": { "gate": "G7_replacement" } },
    { "id": "G8_document_deletion", "factors": { "gate": "G8_document_deletion" } },
    { "id": "G9_collection_deletion", "factors": { "gate": "G9_collection_deletion" } },
    { "id": "G10_identity_stamping", "factors": { "gate": "G10_identity_stamping" } },
    { "id": "G11_generation_invalidation", "factors": { "gate": "G11_generation_invalidation" } },
    { "id": "G12_interrupted_write_recovery", "factors": { "gate": "G12_interrupted_write_recovery" } },
    { "id": "G13_narrowed_lock_concurrent_read", "factors": { "gate": "G13_narrowed_lock_concurrent_read" } },
    { "id": "G14_manifest_plan_agreement", "factors": { "gate": "G14_manifest_plan_agreement" } }
  ],
  "preflight_assertions": [
    { "manifest_field": "vector_store.backend", "operator": "eq", "expected": "lancedb", "reason": "qualification targets LanceDB only" },
    { "manifest_field": "vector_store_requested_backend", "operator": "eq", "expected": "lancedb", "reason": "requested and effective must both be lancedb" },
    { "manifest_field": "vector_store.mode", "operator": "eq", "expected": "embedded" },
    { "manifest_field": "vector_store.score_kind", "operator": "not_null", "reason": "dense score kind must be recorded" },
    { "manifest_field": "vector_store.index_identity", "operator": "not_null", "reason": "immutable index identity for the campaign collection" },
    { "manifest_field": "embedding.effective_provider", "operator": "not_null" },
    { "manifest_field": "embedding.model", "operator": "not_null" },
    { "manifest_field": "sparse.effective_backend", "operator": "eq", "expected": "bm25" },
    { "manifest_field": "corpus_identity", "operator": "not_null" },
    { "manifest_field": "repo_commit", "operator": "not_null" },
    { "manifest_field": "dependency_lock_hash", "operator": "not_null" },
    { "manifest_field": "document_backend.effective", "operator": "not_null", "reason": "pdf_reader pypdf recorded even for non-PDF corpus" }
  ]
}
