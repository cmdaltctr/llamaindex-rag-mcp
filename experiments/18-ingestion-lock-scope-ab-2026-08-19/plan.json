{
  "experiment_id": "18-ingestion-lock-scope-ab",
  "protocol_version": "1.0",
  "experimental_unit": "one generated-corpus ingestion cell (isolated subprocess per cell)",
  "primary_metric": "contended_lock_wait_fraction_of_wall",
  "manipulated_factors": [
    {
      "name": "corpus_size",
      "levels": [3, 25, 100, 400]
    },
    {
      "name": "failure_point",
      "levels": ["none", "parse", "embed", "store_write"]
    },
    {
      "name": "repeat_state",
      "levels": ["first", "first_plus_unchanged_second", "one_file_modified"]
    },
    {
      "name": "ingest_topology",
      "levels": ["sequential_1_stream", "concurrent_2_streams"]
    },
    {
      "name": "embedding_block",
      "levels": ["fake_deterministic", "real_ollama"]
    }
  ],
  "controlled_variables": {
    "seed": 20260819,
    "generator_version": "1.0",
    "target_chars_per_file": 6000,
    "chunk_size": 512,
    "chunk_overlap": 100,
    "metadata_extraction": "disabled",
    "vector_store_backend": "chroma_local_persistent_isolated_per_cell",
    "collection_name": "documents",
    "python": "3.12.10",
    "dependency_lock": "uv.lock frozen",
    "store_backend_block": "chroma only; lancedb is a separate block outside this run"
  },
  "cells": [
    { "id": "bounded_25", "factors": { "corpus_size": 25, "failure_point": "none", "repeat_state": "first_plus_unchanged_second", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "bounded_100", "factors": { "corpus_size": 100, "failure_point": "none", "repeat_state": "first_plus_unchanged_second", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "bounded_400", "factors": { "corpus_size": 400, "failure_point": "none", "repeat_state": "first_plus_unchanged_second", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "modified_25", "factors": { "corpus_size": 25, "failure_point": "none", "repeat_state": "one_file_modified", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "fault_none", "factors": { "corpus_size": 3, "failure_point": "none", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "fault_parse", "factors": { "corpus_size": 3, "failure_point": "parse", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "fault_embed", "factors": { "corpus_size": 3, "failure_point": "embed", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "fault_store_write", "factors": { "corpus_size": 3, "failure_point": "store_write", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "timing_fake_seq_100", "factors": { "corpus_size": 100, "failure_point": "none", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "fake_deterministic" } },
    { "id": "timing_fake_contended_100", "factors": { "corpus_size": 100, "failure_point": "none", "repeat_state": "first", "ingest_topology": "concurrent_2_streams", "embedding_block": "fake_deterministic" } },
    { "id": "timing_real_seq_100", "factors": { "corpus_size": 100, "failure_point": "none", "repeat_state": "first", "ingest_topology": "sequential_1_stream", "embedding_block": "real_ollama" } },
    { "id": "timing_real_contended_100", "factors": { "corpus_size": 100, "failure_point": "none", "repeat_state": "first", "ingest_topology": "concurrent_2_streams", "embedding_block": "real_ollama" } }
  ],
  "preflight_assertions": [
    { "assert": "runner_cells_match_plan", "via": "experiments/_lib/plan.py ExperimentPlan.assert_runner_cells" },
    { "assert": "corpus_identity_recorded", "via": "manifest.corpus_identity == generator manifest sha256" },
    { "assert": "isolated_storage", "via": "every store persist dir under experiments/18-.../output/" },
    { "assert": "metadata_extraction_disabled", "via": "explicit EffectiveSettings in harness.build_fake_settings" },
    { "assert": "old_version_searchable_before_faults", "via": "row count for target file equals first-ingest chunk count" },
    { "assert": "no_model_download_in_measured_cells", "via": "real-block warm-up ingest separated from measured cells" }
  ]
}
