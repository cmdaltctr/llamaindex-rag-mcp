{
  "experiment_id": "example-experiment-2-dense-cross-store-score-parity",
  "protocol_version": "1.1",
  "experimental_unit": "one analytic query vector evaluated against one frozen precomputed vector fixture",
  "primary_metric": "per_fixture_parity_checks_passed",
  "manipulated_factors": [
    {
      "name": "vector_store_backend",
      "levels": ["chroma", "lancedb"]
    }
  ],
  "controlled_variables": {
    "embedding_provider": "precomputed",
    "collection_name_pattern": "exp2_{fixture}",
    "top_k": 10,
    "warmup_repetitions": 1,
    "measured_repetitions": 5,
    "reranker": false,
    "hybrid": false,
    "score_kind": "dense_similarity_v1",
    "pinned_thresholds": [0.9, 0.7, 0.55, 0.45, 0.35, 0.3]
  },
  "cells": [
    {
      "id": "chroma_dense",
      "factors": {
        "vector_store_backend": "chroma"
      }
    },
    {
      "id": "lancedb_dense",
      "factors": {
        "vector_store_backend": "lancedb"
      }
    }
  ],
  "preflight_assertions": [
    {
      "manifest_field": "vector_store.backend",
      "operator": "in",
      "expected": ["chroma", "lancedb"]
    },
    {
      "manifest_field": "vector_store.mode",
      "operator": "eq",
      "expected": "local"
    },
    {
      "manifest_field": "vector_store.score_kind",
      "operator": "eq",
      "expected": "dense_similarity_v1"
    },
    {
      "manifest_field": "vector_store.index_identity",
      "operator": "not_null"
    },
    {
      "manifest_field": "embedding.requested_provider",
      "operator": "eq",
      "expected": "precomputed"
    },
    {
      "manifest_field": "embedding.effective_provider",
      "operator": "eq",
      "expected": "precomputed"
    },
    {
      "manifest_field": "embedding.model",
      "operator": "eq",
      "expected": "fixed-fixture-vectors"
    },
    {
      "manifest_field": "retrieval.hybrid",
      "operator": "eq",
      "expected": false
    },
    {
      "manifest_field": "retrieval.top_k",
      "operator": "eq",
      "expected": 10
    },
    {
      "manifest_field": "retrieval.threshold",
      "operator": "eq",
      "expected": 0.0
    },
    {
      "manifest_field": "retrieval.threshold_score_kind",
      "operator": "eq",
      "expected": "dense_similarity_v1"
    },
    {
      "manifest_field": "corpus_identity",
      "operator": "not_null"
    },
    {
      "manifest_field": "query_set_identity",
      "operator": "not_null"
    },
    {
      "manifest_field": "qrels_identity",
      "operator": "not_null"
    },
    {
      "manifest_field": "repo_commit",
      "operator": "not_null"
    },
    {
      "manifest_field": "dependency_lock_hash",
      "operator": "not_null"
    },
    {
      "manifest_field": "upsert_path",
      "operator": "eq",
      "expected": "upsert_precomputed"
    },
    {
      "manifest_field": "embedding_model_calls_during_upsert",
      "operator": "eq",
      "expected": 0
    },
    {
      "manifest_field": "query_vector_checksum",
      "operator": "not_null"
    }
  ]
}
