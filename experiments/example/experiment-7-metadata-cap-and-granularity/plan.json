{
  "experiment_id": "example-experiment-7-metadata-cap-and-granularity",
  "protocol_version": "1.0",
  "experimental_unit": "one fixture document ingested once per cap cell with a deterministic fake extractor",
  "primary_metric": "selected_chunk_hash_prefix_equality",
  "manipulated_factors": [
    {
      "name": "max_chunks",
      "levels": [1, 3, 10]
    },
    {
      "name": "document",
      "levels": ["synthetic", "realistic_md"]
    }
  ],
  "controlled_variables": {
    "splitting_policy": "SentenceSplitter chunk_size=512 overlap=100 (production metadata policy)",
    "fake_llm_outputs": "pre-registered templates in fixtures/manifest.json",
    "aggregation_rule": "first non-empty per-chunk value wins (chunk 0)",
    "metadata_granularity": "file_aggregate",
    "chunk_settings_between_cells": "unchanged (512/100) across every max_chunks cell",
    "dependency_lock": "uv.lock hash recorded per manifest"
  },
  "cells": [
    {
      "id": "M1__synthetic",
      "factors": {
        "max_chunks": 1,
        "document": "synthetic"
      }
    },
    {
      "id": "M3__synthetic",
      "factors": {
        "max_chunks": 3,
        "document": "synthetic"
      }
    },
    {
      "id": "M10__synthetic",
      "factors": {
        "max_chunks": 10,
        "document": "synthetic"
      }
    },
    {
      "id": "M1__realistic_md",
      "factors": {
        "max_chunks": 1,
        "document": "realistic_md"
      }
    },
    {
      "id": "M3__realistic_md",
      "factors": {
        "max_chunks": 3,
        "document": "realistic_md"
      }
    },
    {
      "id": "M10__realistic_md",
      "factors": {
        "max_chunks": 10,
        "document": "realistic_md"
      }
    }
  ],
  "preflight_assertions": [
    {
      "manifest_field": "repo_commit",
      "operator": "not_null"
    },
    {
      "manifest_field": "dependency_lock_hash",
      "operator": "not_null"
    },
    {
      "manifest_field": "corpus_identity",
      "operator": "not_null"
    },
    {
      "manifest_field": "chunker.requested",
      "operator": "eq",
      "expected": "sentence"
    },
    {
      "manifest_field": "chunker.effective",
      "operator": "eq",
      "expected": "sentence"
    },
    {
      "manifest_field": "chunker.fallback_reason",
      "operator": "is_null"
    },
    {
      "manifest_field": "metadata_granularity",
      "operator": "eq",
      "expected": "file_aggregate"
    },
    {
      "manifest_field": "chunking_settings.chunk_size",
      "operator": "eq",
      "expected": 512
    }
  ]
}
