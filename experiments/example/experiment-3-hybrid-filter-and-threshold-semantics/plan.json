{
  "experiment_id": "3-hybrid-filter-and-threshold-semantics",
  "protocol_version": "1.0",
  "experimental_unit": "one deterministic query against a five-row synthetic fixture collection with precomputed embeddings",
  "primary_metric": "exact_cell_match",
  "manipulated_factors": [
    {
      "name": "mode",
      "levels": ["dense", "hybrid_bm25"]
    },
    {
      "name": "filter",
      "levels": ["none", "category_allowed", "category_eq_allowed", "category_in_allowed"]
    },
    {
      "name": "threshold",
      "levels": [0.0, 0.3]
    },
    {
      "name": "rerank",
      "levels": ["off", "fake_success", "fake_failure"]
    }
  ],
  "controlled_variables": {
    "rrf_k": 60,
    "top_k": 5,
    "fetch_k": 5,
    "query": "q1: 'beacon harbour' with fixed precomputed vector",
    "collection": "exp3_hybrid_filter_threshold_fixture",
    "store": "chromadb EphemeralClient via ChromaVectorStore (no embedding identity)",
    "embeddings": "precomputed fixture vectors; query embedded by an injected fixture double",
    "bm25_settings": "BM25Okapi k1=1.5 b=0.75 (production defaults), store-neutral filter evaluation",
    "sparse_backend": "bm25 (in-process); native sparse must never be selected"
  },
  "cells": [
    {
      "id": "cell_01_dense_allowed_thr0",
      "factors": {"mode": "dense", "filter": "category_allowed", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_02_hybrid_allowed_thr0",
      "factors": {"mode": "hybrid_bm25", "filter": "category_allowed", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_03_hybrid_none_thr0",
      "factors": {"mode": "hybrid_bm25", "filter": "none", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_04_hybrid_allowed_thr_pos",
      "factors": {"mode": "hybrid_bm25", "filter": "category_allowed", "threshold": 0.3, "rerank": "off"}
    },
    {
      "id": "cell_05_hybrid_allowed_thr_pos_fake_success",
      "factors": {"mode": "hybrid_bm25", "filter": "category_allowed", "threshold": 0.3, "rerank": "fake_success"}
    },
    {
      "id": "cell_06_hybrid_allowed_thr_pos_fake_failure",
      "factors": {"mode": "hybrid_bm25", "filter": "category_allowed", "threshold": 0.3, "rerank": "fake_failure"}
    },
    {
      "id": "cell_07_dense_eq_allowed_thr0",
      "factors": {"mode": "dense", "filter": "category_eq_allowed", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_08_hybrid_eq_allowed_thr0",
      "factors": {"mode": "hybrid_bm25", "filter": "category_eq_allowed", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_09_dense_in_allowed_thr0",
      "factors": {"mode": "dense", "filter": "category_in_allowed", "threshold": 0.0, "rerank": "off"}
    },
    {
      "id": "cell_10_hybrid_in_allowed_thr0",
      "factors": {"mode": "hybrid_bm25", "filter": "category_in_allowed", "threshold": 0.0, "rerank": "off"}
    }
  ],
  "preflight_assertions": [
    {"manifest_field": "retrieval.top_k", "operator": "eq", "expected": 5, "reason": "protocol §5 fixed top_k"},
    {"manifest_field": "retrieval.fetch_k", "operator": "eq", "expected": 5, "reason": "protocol §5 fixed fetch_k covering the full fixture"},
    {"manifest_field": "retrieval.rrf_k", "operator": "eq", "expected": 60, "reason": "protocol §5 fixed rrf_k"},
    {
      "manifest_field": "retrieval.threshold",
      "operator": "in",
      "expected": [0.0, 0.3],
      "reason": "protocol §4 Factor C levels"
    },
    {
      "manifest_field": "retrieval.threshold_score_kind",
      "operator": "in",
      "expected": ["dense_similarity_v1", "reranker_sigmoid_v1"],
      "reason": "only declared score kinds may govern thresholding"
    },
    {"manifest_field": "vector_store.backend", "operator": "eq", "expected": "chroma"},
    {"manifest_field": "vector_store.mode", "operator": "eq", "expected": "ephemeral"},
    {
      "manifest_field": "vector_store.score_kind",
      "operator": "eq",
      "expected": "dense_similarity_v1",
      "reason": "canonical dense score kind"
    },
    {"manifest_field": "vector_store.index_identity", "operator": "not_null"},
    {
      "manifest_field": "embedding.requested_provider",
      "operator": "eq",
      "expected": "precomputed_fixture",
      "reason": "honest provider identity for precomputed fixture vectors"
    },
    {"manifest_field": "embedding.effective_provider", "operator": "eq", "expected": "precomputed_fixture"},
    {
      "manifest_field": "embedding.model",
      "operator": "eq",
      "expected": "fixture-fake-embed-model-v1",
      "reason": "injected fixture embed double identity"
    },
    {"manifest_field": "sparse.requested_backend", "operator": "eq", "expected": "bm25", "reason": "protocol §5 no native sparse"},
    {"manifest_field": "corpus_identity", "operator": "not_null"},
    {"manifest_field": "query_set_identity", "operator": "not_null"},
    {"manifest_field": "qrels_identity", "operator": "not_null"},
    {"manifest_field": "repo_commit", "operator": "not_null"},
    {"manifest_field": "dependency_lock_hash", "operator": "not_null"}
  ]
}
