{
  "experiment_id": "14-liteparse-qasper-promotion",
  "protocol_version": "2.0",
  "experimental_unit": "one Qasper document/question pair, paired across parsers",
  "primary_metric": "coverage_at_20",
  "manipulated_factors": [
    {
      "name": "reader",
      "levels": ["pypdf", "liteparse"]
    },
    {
      "name": "rerank",
      "levels": [false, true]
    }
  ],
  "controlled_variables": {
    "top_k": 50,
    "embedding_provider": "ollama",
    "reranker_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "corpus": "qasper-pdfs-immutable"
  },
  "cells": [
    {
      "id": "build_pypdf",
      "factors": {
        "reader": "pypdf"
      }
    },
    {
      "id": "build_liteparse",
      "factors": {
        "reader": "liteparse"
      }
    },
    {
      "id": "pypdf_off",
      "factors": {
        "reader": "pypdf",
        "rerank": false
      }
    },
    {
      "id": "pypdf_on",
      "factors": {
        "reader": "pypdf",
        "rerank": true
      }
    },
    {
      "id": "liteparse_off",
      "factors": {
        "reader": "liteparse",
        "rerank": false
      }
    },
    {
      "id": "liteparse_on",
      "factors": {
        "reader": "liteparse",
        "rerank": true
      }
    }
  ],
  "preflight_assertions": [
    {
      "manifest_field": "document_backend.effective",
      "operator": "in",
      "expected": ["pypdf", "liteparse"],
      "reason": "the requested parser must be the parser that ran (no fallback)"
    },
    {
      "manifest_field": "corpus_identity",
      "operator": "not_null",
      "reason": "the build must record the immutable PDF corpus identity"
    }
  ]
}
