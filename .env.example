# ── Embedding provider ──────────────────────────────────────────────────
# Select the embedding provider: "ollama" (default), "llamacpp", or "openrouter".
# ollama:  convenience wrapper, one-command model pulling, single server
# llamacpp: raw llama.cpp llama-server, better concurrency, no overhead
# openrouter: cloud embedding via OpenRouter API (requires API key)
#
# Note: INFERENCE_BACKEND is deprecated — use EMBED_PROVIDER instead.
EMBED_PROVIDER=ollama

# ── Metadata LLM provider ───────────────────────────────────────────────
# Select the LLM for metadata extraction: "ollama" (default), "llamacpp", or "openrouter".
# Defaults to "ollama" (local, free) regardless of EMBED_PROVIDER to prevent
# unexpected cloud API costs.
METADATA_LLM_PROVIDER=ollama

# ── Embedding model (via Ollama) ────────────────────────────────────────
# Pull the model first:  ollama pull qwen3-embedding:0.6b
EMBED_MODEL=qwen3-embedding:0.6b

# Alternative (larger, more precise):  ollama pull qwen3-embedding:8b
# EMBED_MODEL=qwen3-embedding:8b

# Alternative (lighter, 768-dim):  ollama pull nomic-embed-text
# EMBED_MODEL=nomic-embed-text

# ── Ollama server ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── llama.cpp backend (only needed when EMBED_PROVIDER=llamacpp) ────────
# Install optional deps:  uv sync --extra llamacpp
#
# Recommended: let llama-server download GGUF directly from HuggingFace (-hf flag):
#   llama-server -hf Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0 --port 8080 --embeddings
#   llama-server -hf Qwen/Qwen3-0.6B-GGUF:Q8_0 --port 8081
# Models are cached in ~/.cache/huggingface/hub (same as Ollama's ~/.ollama/models concept)
#
# Offline alternative (hf CLI replaces deprecated huggingface-cli):
#   hf download Qwen/Qwen3-Embedding-0.6B-GGUF Qwen3-Embedding-0.6B-Q8_0.gguf
#   hf download Qwen/Qwen3-0.6B-GGUF Qwen3-0.6B-Q8_0.gguf
# Files go to ~/.cache/huggingface/hub — llama-server -hf will find them there
#
# LLAMACPP_EMBED_URL=http://localhost:8080/v1
# LLAMACPP_EMBED_MODEL=Qwen3-Embedding-0.6B-Q8_0.gguf
# LLAMACPP_CHAT_URL=http://localhost:8081/v1
# LLAMACPP_CHAT_MODEL=Qwen3-0.6B-Q8_0.gguf

# ── OpenRouter (only needed when EMBED_PROVIDER=openrouter or METADATA_LLM_PROVIDER=openrouter) ─
# Install optional deps:  uv sync --extra openrouter
# Get your API key at:  https://openrouter.ai/keys
#
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_EMBED_MODEL=text-embedding-3-small
# OPENROUTER_LLM_MODEL=openai/gpt-4o-mini

# ── Vector store ────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=documents

# ── Chunking ────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# ── Performance ─────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=100
EMBED_CONCURRENCY=4

# ── Retrieval ───────────────────────────────────────────────────────────
TOP_K=10
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SIMILARITY_THRESHOLD=0.0
RERANK_FETCH_MULTIPLIER=3
RERANK_MAX_FETCH=100

# ── Metadata extraction ──────────────────────────────────────────────────
# llamaindex: per-chunk enrichment via LlamaIndex pipeline (requires METADATA_LLM_PROVIDER deps)
# local: per-file LLM classification (uses METADATA_LLM_PROVIDER for LLM selection)
# keyword: regex pattern matching (no LLM required)
# disabled: no metadata extraction
# Install the optional dep first: uv sync --extra metadata
METADATA_EXTRACTION_MODE=llamaindex
OLLAMA_CLASSIFY_MODEL=qwen3:0.6b
# LLAMANDEX_EXTRACTOR_MAX_CHUNKS=10

# ── Hugging Face ──────────────────────────────────────────────────
# HF_TOKEN=hf_your_token_here

# ── PDF reader selection ───────────────────────────────────────────
PDF_READER=auto
LITEPARSE_OCR_ENABLED=false

# ── Codebase map: Magika file-type detection ────────────────────────
# MAGIKA_BINARY=magika
# DOC_SIMILARITY_THRESHOLD=0.85
# CODEBASE_MAP_CACHE_DIR=.opencode
# CODEBASE_MAP_MAX_FILES=5000
# CODEBASE_MAP_MAX_DEPTH=10

# ── Document backend selection ──────────────────────────────────────
DOCUMENT_BACKEND=local
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOC_INTELLIGENCE_KEY=
# AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

# ── SonarCloud CLI (local secrets scanning + analysis) ─────────────
# SONARQUBE_CLI_TOKEN=your_token_here
# SONARQUBE_CLI_ORG=your_org_name
