# Embedding model (via Ollama) — any model from https://ollama.com/search?c=embedding
# Pull a model first: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# Ollama server URL (optional, defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB persistent directory — where the vector DB is stored on disk
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name
COLLECTION_NAME=documents

# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Number of chunks to return per query
TOP_K=5

# Reranker (optional, off by default)
# Uses a small cross-encoder model (~23MB) to re-score vector search
# results for better precision. Downloads the model on first use.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=false
SIMILARITY_THRESHOLD=0.0
