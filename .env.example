# Embedding model (via Ollama) — any model from https://ollama.com/search?c=embedding
#
# Pick one and pull it first:
#
#   ollama pull qwen3-embedding:0.6b  # ~400 MB, fast, 1024-dim (recommended)
#   ollama pull qwen3-embedding:8b    # ~3 GB, higher precision, 1024-dim
#   ollama pull nomic-embed-text      # ~274 MB, lighter / 768-dim
#
EMBED_MODEL=qwen3-embedding:0.6b

# Ollama server URL (optional, defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB persistent directory — where the vector DB is stored on disk
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name
COLLECTION_NAME=documents

# Chunking configuration
CHUNK_SIZE=512
# CHUNK_OVERLAP defaults to 100 (Stäbler et al. 2025 empirical sweet spot).
# The previous default was 64; existing collections continue to work and
# only pick up the new value on re-ingestion.
CHUNK_OVERLAP=100

# Embedding batch size (Ollama /api/embed batch — higher = fewer round-trips)
EMBED_BATCH_SIZE=100

# Max concurrent Ollama embedding API calls
EMBED_CONCURRENCY=2

# Markdown-only chunking configuration. Experiment 6c promoted 1024 for
# Markdown files; non-Markdown files continue to use CHUNK_SIZE=512.
MARKDOWN_CHUNK_SIZE=1024
# Experimental Markdown recovery knobs from Experiment 6c. Leave off unless
# running a follow-up experiment or deliberately testing heading/context fixes.
# MARKDOWN_HEADING_PREPEND=false
# MARKDOWN_MIN_CHUNK_FRACTION=0.0

# Balanced retrieval profile (Experiments 7a/8a): keep overlap 100, rerank by
# default, and return 10 chunks.  This is a good evidence-retrieval trade-off:
# better Qasper Recall@5 than overlap 64 at comparable latency, without the
# much higher cost of top_k=20.  Override per workflow if you need faster or
# deeper search.
TOP_K=10

# Reranker policy (ADR-019: default-off after Experiment 10)
# Uses a small cross-encoder model (~23MB) to re-score vector search
# results for better precision. Downloads the model on first use.
#
# RERANK_ENABLED: Global default for omitted rerank requests.
#   - true: always rerank when rerank is omitted
#   - false: do not rerank by default (policy may override for semantic queries)
#
# RERANK_ENABLED_FOR_SEMANTIC: Policy knob for semantic workload override.
#   When RERANK_ENABLED=false and this is true, the policy resolver enables
#   reranking for semantic (non-technical) queries below the threshold.
#
# HARD_TECHNICAL_THRESHOLD: Identifier-heavy workload fraction (0.0–1.0).
#   When technical_fraction >= this value, policy reranking is disabled.
#   Experiment 10 showed the cross-encoder degrades Coverage@20 by 19–27%
#   at ≥30% identifier-heavy queries.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=false
RERANK_ENABLED_FOR_SEMANTIC=true
HARD_TECHNICAL_THRESHOLD=0.3
SIMILARITY_THRESHOLD=0.0

# Hybrid retrieval (dense + sparse BM25 fused with Reciprocal Rank Fusion).
# Defaults are deliberately opt-in for v1; promotion of
# HYBRID_SPARSE_BACKEND to auto is a follow-up change after Experiment 9.
HYBRID_ENABLED=false
HYBRID_RRF_K=60
HYBRID_SPARSE_BACKEND=bm25

# ── PDF reader selection ───────────────────────────────────────────
# Controls which parser handles .pdf files. Accepted: auto, liteparse,
# pypdfium2, pypdf. Default: auto (LiteParse is a core dependency).
# See ADR-020.
PDF_READER=auto

# LiteParse constructor knobs (only effective when PDF_READER=liteparse).
# OCR is disabled by default — corpus has no scanned PDFs; OCR adds ~16s/file.
LITEPARSE_OCR_ENABLED=false
# LITEPARSE_NUM_WORKERS=

# ── Metadata extraction ────────────────────────────────────────────
# Controls how document metadata (e.g., category) is extracted during
# ingestion.  Allowed values:
#   "disabled"   – no metadata extraction
#   "keyword"    – regex pattern matching (default, zero deps, instant)
#   "ollama"     – local Ollama chat model classification
#   "llamaindex" – LlamaIndex MetadataExtractor pipeline (per-chunk enrichment)
#                  Degradation: llamaindex → ollama → keyword (automatic)
METADATA_EXTRACTION_MODE=keyword

# Maximum number of chunks to process in the LlamaIndex metadata
# extraction pipeline (only when METADATA_EXTRACTION_MODE=llamaindex).
# Each chunk triggers one LLM call.  Default 10 balances quality
# with speed (~10 × ~2s = ~20s per document).
# LLAMANDEX_EXTRACTOR_MAX_CHUNKS=10

# Optional JSON string of [{"pattern": "regex", "category": "name"}, ...]
# overriding the built-in default keyword rules.  Example:
#   METADATA_KEYWORD_RULES='[{"pattern": "f1|grand.?prix", "category": "Motorsport"}]'
# Falls back to default rules on parse error (WARNING logged).
# METADATA_KEYWORD_RULES=

# Chat model used for Ollama-based classification (only when
# METADATA_EXTRACTION_MODE=ollama).  Pull it first:
#   ollama pull qwen3:0.6b
OLLAMA_CLASSIFY_MODEL=qwen3:0.6b

# ── Codebase map: Magika file-type detection ────────────────────────
# Path to the Magika CLI binary. Install via `brew install magika`.
# If not found, falls back to suffix-based detection.
# MAGIKA_BINARY=magika

# ── Codebase map: document similarity threshold ─────────────────────
# Cosine similarity threshold for document graph edges (default 0.85).
# Lower = more edges, higher = fewer edges. Needs calibration experiment.
# DOC_SIMILARITY_THRESHOLD=0.85

# ── Codebase map: cache directory ───────────────────────────────────
# Per-project cache for codebase map, keyed by git commit hash.
# CODEBASE_MAP_CACHE_DIR=.opencode

# ── Codebase map: file count and depth limits ───────────────────────
# Maximum number of files to scan before truncating (default 5000).
# CODEBASE_MAP_MAX_FILES=5000
# Maximum directory depth for recursive scanning (default 10).
# CODEBASE_MAP_MAX_DEPTH=10

# ── Document backend selection ──────────────────────────────────────
# Controls document parsing backend. Accepted: "local" (default), "azure".
# "local" uses LiteParse → pypdfium2 → pypdf chain.
# "azure" uses Azure Document Intelligence with automatic fallback to local.
DOCUMENT_BACKEND=local

# Azure Document Intelligence credentials (only needed when DOCUMENT_BACKEND=azure).
# AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOC_INTELLIGENCE_KEY=
# AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout
